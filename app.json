{
  "expo": {
    "name": "Zylo",
    "slug": "fos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/zylo_icon.png",
    "scheme": "fos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zylobrains.fos",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive_zylo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6366f1",
          "dark": {
            "backgroundColor": "#6366f1"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "44473038-e398-44c5-b04f-23b33b92b81c"
      }
    }
  }
}
