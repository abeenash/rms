{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.zylobrains.com/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://api.zylobrains.com/api/v1/ws",
        "EXPO_PUBLIC_WS_ENABLED": "false"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.zylobrains.com/api/v1",
        "EXPO_PUBLIC_WS_URL": "wss://api.zylobrains.com/api/v1/ws",
        "EXPO_PUBLIC_WS_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
